<ui:FluentWindow
    x:Class="Reclaim.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:Reclaim.App.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Reclaim.App.Views"
    Title="Reclaim"
    Width="1320"
    Height="860"
    MinWidth="980"
    MinHeight="620"
    AllowDrop="True"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="Reclaim" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/reclaim-32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Padding="36,8,36,0"
            CompactPaneLength="56"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="236"
            PaneDisplayMode="Left">
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="16,4,0,16" Orientation="Horizontal">
                    <Image Width="28" Height="28" Source="pack://application:,,,/Assets/reclaim-64.png" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Reclaim" />
                        <TextBlock Style="{StaticResource Tertiary}" Text="Uninstaller &amp; cleaner" />
                    </StackPanel>
                </StackPanel>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Home" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type pages:HomePage}" />
                <ui:NavigationViewItem Content="Apps" Icon="{ui:SymbolIcon Apps24}" TargetPageType="{x:Type pages:AppsPage}" />
                <ui:NavigationViewItem Content="Hunter" Icon="{ui:SymbolIcon Target24}" TargetPageType="{x:Type pages:HunterPage}" />
                <ui:NavigationViewItem Content="Force uninstall" Icon="{ui:SymbolIcon DeleteDismiss24}" TargetPageType="{x:Type pages:ForcePage}" />
                <ui:NavigationViewItem Content="Install monitor" Icon="{ui:SymbolIcon Pulse24}" TargetPageType="{x:Type pages:MonitorPage}" />
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem Content="Cleanup" Icon="{ui:SymbolIcon Broom24}" TargetPageType="{x:Type pages:CleanupPage}" />
                <ui:NavigationViewItem Content="Startup" Icon="{ui:SymbolIcon Rocket24}" TargetPageType="{x:Type pages:StartupPage}" />
                <ui:NavigationViewItem Content="Tools" Icon="{ui:SymbolIcon Toolbox24}" TargetPageType="{x:Type pages:ToolsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Backups" Icon="{ui:SymbolIcon History24}" TargetPageType="{x:Type pages:BackupsPage}" />
                <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!--  Uninstall sheet: dimmed backdrop + panel sliding in from the right  -->
        <Grid x:Name="SheetLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="Scrim" Background="#66000000" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" Opacity="0" />
            <Border
                x:Name="SheetPanel"
                Width="680"
                HorizontalAlignment="Right"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Direction="180" Opacity="0.35" ShadowDepth="0" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SheetTransform" X="680" />
                </Border.RenderTransform>
                <views:UninstallSheet x:Name="Sheet" />
            </Border>
        </Grid>

        <ContentPresenter x:Name="RootContentDialog" Grid.Row="0" Grid.RowSpan="2" />

        <!--  Drag & drop hint  -->
        <Border x:Name="DropHint" Grid.Row="1" Margin="24" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="16" IsHitTestVisible="False" Visibility="Collapsed"
                Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon HorizontalAlignment="Center" FontSize="48" Symbol="ArrowDownload24" />
                <TextBlock Margin="0,12,0,0" FontSize="18" FontWeight="SemiBold" Text="Drop a program or shortcut to uninstall it" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
