<UserControl
    x:Class="Reclaim.App.Views.UninstallSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Reclaim.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:UninstallWizardViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Margin="28,24,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" Margin="0,0,16,0" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <Grid>
                    <ui:SymbolIcon FontSize="26" Symbol="Apps24" Visibility="{Binding HeaderIcon, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                    <Image Width="36" Height="36" Source="{Binding HeaderIcon}" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="13" Text="{Binding Subtitle}" />
            </StackPanel>
            <ui:Button Grid.Column="2" VerticalAlignment="Top" Appearance="Transparent" AutomationProperties.Name="Close" Command="{Binding CancelCommand}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Close" />
        </Grid>

        <!--  Stepper  -->
        <Grid Grid.Row="1" Margin="28,22,28,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Height="4" Margin="0,0,4,6" CornerRadius="2" Background="{Binding StepIndex, Converter={StaticResource StepBrush}, ConverterParameter=0}" />
                <TextBlock Style="{StaticResource Secondary}" Text="Prepare" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <Border Height="4" Margin="0,0,4,6" CornerRadius="2" Background="{Binding StepIndex, Converter={StaticResource StepBrush}, ConverterParameter=1}" />
                <TextBlock Style="{StaticResource Secondary}" Text="Uninstall" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Border Height="4" Margin="0,0,4,6" CornerRadius="2" Background="{Binding StepIndex, Converter={StaticResource StepBrush}, ConverterParameter=2}" />
                <TextBlock Style="{StaticResource Secondary}" Text="Scan" />
            </StackPanel>
            <StackPanel Grid.Column="3">
                <Border Height="4" Margin="0,0,4,6" CornerRadius="2" Background="{Binding StepIndex, Converter={StaticResource StepBrush}, ConverterParameter=3}" />
                <TextBlock Style="{StaticResource Secondary}" Text="Review leftovers" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Border Height="4" Margin="0,0,0,6" CornerRadius="2" Background="{Binding StepIndex, Converter={StaticResource StepBrush}, ConverterParameter=4}" />
                <TextBlock Style="{StaticResource Secondary}" Text="Done" />
            </StackPanel>
        </Grid>

        <!--  ============ Step 1: Prepare ============  -->
        <Grid Grid.Row="2" Visibility="{Binding Step, Converter={StaticResource Equals}, ConverterParameter=Prepare}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Padding="28,8,28,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl Margin="0,4,0,8" ItemsSource="{Binding AppStatuses}" Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="8,6,12,6" CornerRadius="16" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="18" Height="18" Margin="0,0,8,0" Source="{Binding Icon}" />
                                        <TextBlock FontSize="12" Text="{Binding App.Name}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,8,0,10" Text="Safety" />
                    <Border Style="{StaticResource Card}" Padding="16,6">
                        <StackPanel>
                            <CheckBox Margin="0,8" IsChecked="{Binding CreateRestorePoint}" Visibility="{Binding RunsUninstaller, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Create a System Restore point first" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Lets you roll Windows back if something goes wrong" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Margin="0,8" IsChecked="{Binding FullRegistryBackup}" Visibility="{Binding RunsUninstaller, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Back up the entire registry" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Slower. Removed leftovers are always backed up individually." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Margin="0,8" IsChecked="{Binding StoreAllUsers}" Visibility="{Binding HasStoreApps, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Remove for every user and new accounts" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Also de-provisions the Windows app" />
                                </StackPanel>
                            </CheckBox>
                            <Grid Margin="0,8" Visibility="{Binding CanQuiet, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Quiet mode" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="Skip the uninstallers' own windows and prompts where possible" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Quiet}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,20,0,10" Text="Leftover scan" />
                    <RadioButton GroupName="scan" IsChecked="{Binding ScanMode, Converter={StaticResource Equals}, ConverterParameter=Safe}" Style="{StaticResource OptionCard}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Safe" />
                            <TextBlock Style="{StaticResource Secondary}" Text="Only items that provably belong to the program. Fastest." TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="scan" IsChecked="{Binding ScanMode, Converter={StaticResource Equals}, ConverterParameter=Moderate}" Style="{StaticResource OptionCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="Moderate" />
                                <Border Margin="8,0,0,0" Style="{StaticResource Pill}" Background="{Binding Source=Accent, Converter={StaticResource ToneBrush}, ConverterParameter=bg}">
                                    <TextBlock Style="{StaticResource PillText}" Text="Recommended" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="Also checks app data folders, settings keys, file types and usage traces." TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="scan" IsChecked="{Binding ScanMode, Converter={StaticResource Equals}, ConverterParameter=Advanced}" Style="{StaticResource OptionCard}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Advanced" />
                            <TextBlock Style="{StaticResource Secondary}" Text="Deep sweep: COM components, shell extensions, drivers and every registry reference to the program's folder." TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Padding="28,16" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Command="{Binding CloseCommand}" Content="Cancel" />
                    <ui:Button MinWidth="160" Appearance="Primary" Command="{Binding StartCommand}" Content="{Binding StartButtonText}" Icon="{ui:SymbolIcon Delete24}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  ============ Step 2: Uninstalling ============  -->
        <Grid Grid.Row="2" Margin="28,8,28,20" Visibility="{Binding Step, Converter={StaticResource Equals}, ConverterParameter=Uninstalling}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:ProgressRing Width="36" Height="36" Margin="0,0,16,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="Removing the program" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <ui:InfoBar Grid.Row="1" Margin="0,12,0,0" IsClosable="False" IsOpen="True" Message="{Binding Problem}" Severity="Warning" Title="The uninstaller didn't finish" Visibility="{Binding Problem, Converter={StaticResource HasValueToVis}}" />
            <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding AppStatuses}" Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Style="{StaticResource SubtleCard}" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="24" Height="24" Margin="0,0,12,0" Source="{Binding Icon}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding App.Name}" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=bg}">
                                            <TextBlock Style="{StaticResource PillText}" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" Text="{Binding Status}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Margin="0,8,0,0" Header="Details" IsExpanded="False">
                        <ItemsControl FontFamily="Cascadia Mono, Consolas" FontSize="12" ItemsSource="{Binding LogLines}" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="Stop" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <ui:Button Margin="0,0,8,0" Command="{Binding CloseCommand}" Content="Close" Visibility="{Binding Problem, Converter={StaticResource HasValueToVis}}" />
                <ui:Button Appearance="Primary" Command="{Binding ScanAnywayCommand}" Content="Scan for leftovers anyway" Visibility="{Binding Problem, Converter={StaticResource HasValueToVis}}" />
            </StackPanel>
        </Grid>

        <!--  ============ Step 3: Scanning / cleaning ============  -->
        <StackPanel Grid.Row="2" Margin="28,40,28,20" Visibility="{Binding Step, Converter={StaticResource Equals}, ConverterParameter=Scanning}">
            <ui:ProgressRing Width="56" Height="56" HorizontalAlignment="Center" IsIndeterminate="True" />
            <TextBlock Margin="0,24,0,4" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Working…" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding StatusText}" TextAlignment="Center" TextWrapping="Wrap" />
            <ui:Button Margin="0,24,0,0" HorizontalAlignment="Center" Command="{Binding CancelCommand}" Content="Cancel" />
            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Problem}" Visibility="{Binding Problem, Converter={StaticResource HasValueToVis}}" />
        </StackPanel>

        <!--  ============ Step 4: Review ============  -->
        <Grid Grid.Row="2" Visibility="{Binding Step, Converter={StaticResource Equals}, ConverterParameter=Review}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="28,8,28,8">
                <WrapPanel>
                    <Border Style="{StaticResource Pill}" Background="{Binding Source=Certain, Converter={StaticResource ToneBrush}, ConverterParameter=bg}">
                        <TextBlock Style="{StaticResource PillText}" Foreground="{Binding Source=Certain, Converter={StaticResource ToneBrush}}"><Run Text="{Binding CertainCount, Mode=OneWay}" /><Run Text=" certain" /></TextBlock>
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="{Binding Source=Likely, Converter={StaticResource ToneBrush}, ConverterParameter=bg}">
                        <TextBlock Style="{StaticResource PillText}" Foreground="{Binding Source=Likely, Converter={StaticResource ToneBrush}}"><Run Text="{Binding LikelyCount, Mode=OneWay}" /><Run Text=" likely" /></TextBlock>
                    </Border>
                    <Border Style="{StaticResource Pill}">
                        <TextBlock Style="{StaticResource PillText}"><Run Text="{Binding PossibleCount, Mode=OneWay}" /><Run Text=" possible" /></TextBlock>
                    </Border>
                </WrapPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Secondary}" FontSize="13">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" selected · " /><Run Text="{Binding SelectedSize, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:HyperlinkButton Padding="6,2" Command="{Binding SelectCommand}" CommandParameter="certain" Content="Certain" />
                        <ui:HyperlinkButton Padding="6,2" Command="{Binding SelectCommand}" CommandParameter="likely" Content="+ Likely" />
                        <ui:HyperlinkButton Padding="6,2" Command="{Binding SelectCommand}" CommandParameter="all" Content="All" />
                        <ui:HyperlinkButton Padding="6,2" Command="{Binding SelectCommand}" CommandParameter="none" Content="None" />
                        <ui:Button Margin="6,0,0,0" Appearance="Transparent" Command="{Binding ExportLeftoversCommand}" Icon="{ui:SymbolIcon ArrowExportUp24}" ToolTip="Export as HTML" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <TreeView x:Name="LeftoverTree" Grid.Row="1" Margin="20,0,20,0" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Tree}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource DefaultTreeViewItemStyle}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:LeftoverNodeViewModel}" ItemsSource="{Binding Children}">
                        <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="400">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding OpenItemCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Open location" />
                                    <MenuItem Command="{Binding ExcludeItemCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Never offer this again (exclude)" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <CheckBox MinWidth="0" Margin="0,0,6,0" VerticalAlignment="Center" IsChecked="{Binding IsChecked}" />
                            <ui:SymbolIcon Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Symbol="{Binding KindGlyph}" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <Border Grid.Column="1" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" CornerRadius="4" Background="{Binding Tone, Converter={StaticResource ToneBrush}}"
                                    Visibility="{Binding Tone, Converter={StaticResource HasValueToVis}}" />
                            <TextBlock Grid.Column="2" MaxWidth="440" VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Tertiary}" Text="{Binding Detail}" />
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <Border Grid.Row="2" Padding="28,16" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Tertiary}" Text="Everything removed is backed up and can be undone." />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Command="{Binding SkipCleanupCommand}" Content="Keep all" />
                        <ui:Button MinWidth="170" Appearance="Danger" AutomationProperties.Name="Remove selected leftovers" Command="{Binding RemoveSelectedCommand}" Icon="{ui:SymbolIcon Delete24}">
                            <TextBlock><Run Text="Remove " /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" items" /></TextBlock>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  ============ Step 5: Done ============  -->
        <StackPanel Grid.Row="2" Margin="28,40,28,20" Visibility="{Binding Step, Converter={StaticResource Equals}, ConverterParameter=Done}">
            <Border Width="88" Height="88" CornerRadius="44" Background="{Binding Source=Success, Converter={StaticResource ToneBrush}, ConverterParameter=bg}">
                <ui:SymbolIcon FontSize="44" Filled="True" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Symbol="Checkmark24" />
            </Border>
            <TextBlock Margin="0,20,0,6" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Text="{Binding DoneTitle}" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Secondary}" FontSize="14" Text="{Binding DoneMessage}" TextAlignment="Center" TextWrapping="Wrap" />
            <ui:InfoBar Margin="0,20,0,0" IsClosable="False" IsOpen="True" Message="Windows needs a restart to finish removing some files." Severity="Informational" Title="Restart required"
                        Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}" />
            <Expander Margin="0,16,0,0" Header="Items that couldn't be removed right away" Visibility="{Binding Errors.Count, Converter={StaticResource HasValueToVis}}">
                <ItemsControl FontSize="12" ItemsSource="{Binding Errors}" />
            </Expander>
            <StackPanel Margin="0,28,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Command="{Binding UndoCommand}" Content="Undo cleanup" Icon="{ui:SymbolIcon ArrowUndo24}"
                           Visibility="{Binding BackupFolder, Converter={StaticResource HasValueToVis}}" IsEnabled="{Binding Undone, Converter={StaticResource InverseBool}}" />
                <ui:Button Margin="0,0,8,0" Command="{Binding RestartCommand}" Content="Restart now" Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}" />
                <ui:Button MinWidth="120" Appearance="Primary" Command="{Binding CloseCommand}" Content="Close" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
