<Page
    x:Class="Reclaim.App.Views.Pages.HunterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Hunter">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Hunter mode" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Don't know which program owns that tray icon, pop-up or desktop shortcut? Point at it." />

            <Border Margin="0,24,0,0" Style="{StaticResource Card}" Padding="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="140" Height="140" Margin="0,0,36,0">
                        <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.12" />
                        <Ellipse Margin="22" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="4" />
                        <Ellipse Margin="52" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Rectangle Width="3" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.6" />
                        <Rectangle Height="3" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.6" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="How it works" />
                        <TextBlock Margin="0,12,0,0" FontSize="14" Text="1.  Start Hunter. Reclaim tucks itself away and shows a small target." />
                        <TextBlock Margin="0,6,0,0" FontSize="14" Text="2.  Drag the target onto a window, a desktop icon or a taskbar or tray icon." />
                        <TextBlock Margin="0,6,0,0" FontSize="14" Text="3.  Let go and choose: uninstall it, stop it starting with Windows, close it, or open its folder." />
                        <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Click="Start_Click" Content="Start Hunter" Icon="{ui:SymbolIcon Target24}" Padding="18,8" />
                            <CheckBox x:Name="HideMain" Margin="18,0,0,0" Content="Minimize Reclaim while hunting" IsChecked="True" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Tips" />
            <UniformGrid Margin="0,0,-12,0" Columns="3">
                <Border Margin="0,0,12,12" Style="{StaticResource SubtleCard}">
                    <StackPanel>
                        <ui:SymbolIcon HorizontalAlignment="Left" FontSize="22" Symbol="Desktop24" />
                        <TextBlock Margin="0,8,0,2" FontWeight="SemiBold" Text="Desktop shortcuts" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Aim at the icon itself, not its label." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,12" Style="{StaticResource SubtleCard}">
                    <StackPanel>
                        <ui:SymbolIcon HorizontalAlignment="Left" FontSize="22" Symbol="PanelBottom20" />
                        <TextBlock Margin="0,8,0,2" FontWeight="SemiBold" Text="Taskbar and tray" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Open the hidden-icons overflow first, then aim at the icon." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,12" Style="{StaticResource SubtleCard}">
                    <StackPanel>
                        <ui:SymbolIcon HorizontalAlignment="Left" FontSize="22" Symbol="ArrowMove24" />
                        <TextBlock Margin="0,8,0,2" FontWeight="SemiBold" Text="Or just drop it" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Drag any program file or shortcut onto Reclaim's window to uninstall it." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
