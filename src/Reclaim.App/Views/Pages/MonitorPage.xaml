<Page
    x:Class="Reclaim.App.Views.Pages.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Reclaim.App.ViewModels"
    Title="Install monitor"
    d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,24">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Install monitor" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Record exactly what an installer changes, so the program can later be removed completely." />
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ImportCommand}" Content="Import log" Icon="{ui:SymbolIcon ArrowImport24}" />
            </Grid>

            <!--  Idle: call to action  -->
            <Border Margin="0,24,0,0" Style="{StaticResource Card}" Padding="24" Visibility="{Binding State, Converter={StaticResource Equals}, ConverterParameter=Idle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" Margin="0,0,18,0" CornerRadius="14" Background="{Binding Source=Accent, Converter={StaticResource ToneBrush}, ConverterParameter=bg}">
                        <ui:SymbolIcon FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Pulse24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Install &amp; trace a new program" />
                        <TextBlock Style="{StaticResource Secondary}" FontSize="13" Text="Pick an installer. Reclaim watches its files in real time and compares the registry, services, tasks and firewall afterwards." TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Margin="18,0,0,0" Appearance="Primary" Command="{Binding StartTraceCommand}" Content="Choose installer…" Icon="{ui:SymbolIcon Play24}" />
                </Grid>
            </Border>

            <!--  Active trace  -->
            <Border Margin="0,24,0,0" Padding="24">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Idle">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:ProgressRing Width="44" Height="44" Margin="0,0,18,0" IsIndeterminate="True" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding InstallerName, StringFormat='Tracing {0}'}" />
                        <TextBlock Style="{StaticResource Secondary}" FontSize="13" Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <Border Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource Pill}" Background="{Binding Source=Success, Converter={StaticResource ToneBrush}, ConverterParameter=bg}"
                                Visibility="{Binding RealTime, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource PillText}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="Real-time monitoring" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Command="{Binding CancelTraceCommand}" Content="Cancel" />
                        <ui:Button Appearance="Primary" Command="{Binding FinishTraceCommand}" Content="Finish" Icon="{ui:SymbolIcon Checkmark24}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Traced programs" />
            <ItemsControl ItemsSource="{Binding Traces}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TraceItemViewModel}">
                        <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon DocumentBulletList24}">
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Secondary}"><Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Summary, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" Orientation="Horizontal">
                                        <ui:Button Margin="0,0,6,0" Appearance="Danger" Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Content="Uninstall" />
                                        <ui:Button Margin="0,0,6,0" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ArrowExportUp24}" ToolTip="Export / share" />
                                        <ui:Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete trace" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8" Style="{StaticResource Tertiary}" Text="{Binding Method}" />
                                <ItemsControl MaxHeight="320" FontFamily="Cascadia Mono, Consolas" FontSize="12" ItemsSource="{Binding Details}">
                                    <ItemsControl.Template>
                                        <ControlTemplate>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                </ItemsControl>
                            </StackPanel>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Secondary}" FontSize="13" Text="No traced installs yet. Programs installed with tracing can be removed down to the last registry value."
                       Visibility="{Binding Traces.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
        </StackPanel>
    </ScrollViewer>
</Page>
