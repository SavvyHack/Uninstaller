<Page
    x:Class="Reclaim.App.Views.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Reclaim.App.ViewModels"
    Title="Cleanup"
    d:DataContext="{d:DesignInstance Type=vm:CleanupViewModel}"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  Shared layout for Windows / Browsers / Office checklists  -->
        <DataTemplate x:Key="CleanerRow" DataType="{x:Type vm:CleanerItemViewModel}">
            <Grid Margin="4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox MinWidth="0" Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="{Binding Selected}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Description}" Visibility="{Binding Description, Converter={StaticResource HasValueToVis}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding SizeText}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="0,8,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Cleanup" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Free up space and erase the traces Windows, browsers and Office keep." />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,20,0,8">
            <RadioButton Content="Junk files" GroupName="sec" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Junk}" Style="{StaticResource Chip}" />
            <RadioButton Content="Windows" GroupName="sec" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Windows}" Style="{StaticResource Chip}" />
            <RadioButton Content="Browsers" GroupName="sec" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Browsers}" Style="{StaticResource Chip}" />
            <RadioButton Content="Microsoft Office" GroupName="sec" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Office}" Style="{StaticResource Chip}" />
            <RadioButton Content="Evidence remover" GroupName="sec" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Evidence}" Style="{StaticResource Chip}" />
            <RadioButton Content="Shredder" GroupName="sec" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Shredder}" Style="{StaticResource Chip}" />
        </WrapPanel>

        <!--  Junk files  -->
        <Grid Grid.Row="2" Visibility="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Junk}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,16,0" VerticalAlignment="Top" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Drives" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,4" Content="{Binding Label}" IsChecked="{Binding Selected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Margin="0,12,0,0" Content="Send to the Recycle Bin" IsChecked="{Binding JunkToRecycleBin}" />
                    <ui:Button Margin="0,16,0,0" HorizontalAlignment="Stretch" Appearance="Primary" Command="{Binding ScanJunkCommand}" Content="Scan" Icon="{ui:SymbolIcon ScanText24}" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Tertiary}" Text="Patterns and excluded folders are set in Settings." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="10,6,6,8">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding JunkSummary}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding JunkFiles.Count, Converter={StaticResource HasValueToVis}}">
                            <ui:HyperlinkButton Padding="6,2" Command="{Binding SelectAllJunkCommand}" CommandParameter="true" Content="All" />
                            <ui:HyperlinkButton Padding="6,2" Command="{Binding SelectAllJunkCommand}" CommandParameter="false" Content="None" />
                            <ui:Button Margin="8,0,0,0" Appearance="Danger" Command="{Binding DeleteJunkCommand}" Content="Delete selected" Icon="{ui:SymbolIcon Delete24}" />
                        </StackPanel>
                    </Grid>
                    <ListView Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RowItem}" ItemsSource="{Binding JunkFiles}" VirtualizingPanel.IsVirtualizing="True">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:JunkFileViewModel}">
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox MinWidth="0" Margin="0,0,8,0" IsChecked="{Binding Selected}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    <Border Grid.Column="2" Margin="8,0" Style="{StaticResource Pill}">
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding Pattern}" />
                                    </Border>
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding SizeText}" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!--  Windows / Browsers / Office  -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Windows}">
            <DockPanel>
                <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitle}" Text="{Binding WindowsTotal, StringFormat='Windows history and temporary files  {0}'}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Command="{Binding AnalyzeCommand}" CommandParameter="Windows" Content="Analyze" Icon="{ui:SymbolIcon ScanText24}" />
                        <ui:Button Appearance="Primary" Command="{Binding CleanCommand}" CommandParameter="Windows" Content="Clean" Icon="{ui:SymbolIcon Broom24}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemTemplate="{StaticResource CleanerRow}" ItemsSource="{Binding WindowsItems}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Browsers}">
            <DockPanel>
                <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitle}" Text="{Binding BrowserTotal, StringFormat='Browser history, cache and cookies  {0}'}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Command="{Binding AnalyzeCommand}" CommandParameter="Browsers" Content="Analyze" Icon="{ui:SymbolIcon ScanText24}" />
                        <ui:Button Appearance="Primary" Command="{Binding CleanCommand}" CommandParameter="Browsers" Content="Clean" Icon="{ui:SymbolIcon Broom24}" />
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,0,0,8" DockPanel.Dock="Top" Style="{StaticResource Secondary}" Text="Close your browsers first. Saved passwords and bookmarks are never touched." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding BrowserItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CleanerItemViewModel}">
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox MinWidth="0" Margin="0,0,10,0" IsChecked="{Binding Selected}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Group}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Office}">
            <DockPanel>
                <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitle}" Text="Recently used Office documents" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Command="{Binding AnalyzeCommand}" CommandParameter="Office" Content="Analyze" Icon="{ui:SymbolIcon ScanText24}" />
                        <ui:Button Appearance="Primary" Command="{Binding CleanCommand}" CommandParameter="Office" Content="Clean" Icon="{ui:SymbolIcon Broom24}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OfficeItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CleanerItemViewModel}">
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox MinWidth="0" Margin="0,0,10,0" IsChecked="{Binding Selected}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Group}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding SizeText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource Secondary}" Text="Microsoft Office doesn't seem to be installed for this user." Visibility="{Binding OfficeItems.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>
        </Border>

        <!--  Evidence remover  -->
        <Border Grid.Row="2" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource Card}" Padding="24"
                Visibility="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Evidence}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Make deleted files unrecoverable" />
                <TextBlock Margin="0,4,0,16" Style="{StaticResource Secondary}" FontSize="13" Text="Emptying the Recycle Bin only marks files as deleted. Recovery tools can still bring them back. Evidence remover overwrites all free space so they can't." TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Secondary}" Text="Drive" />
                        <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding Drives}" SelectedItem="{Binding EvidenceDrive}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Secondary}" Text="Passes" />
                        <ui:NumberBox Maximum="7" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding EvidencePasses}" />
                    </StackPanel>
                </Grid>
                <ui:InfoBar Margin="0,16,0,0" IsClosable="False" IsOpen="True" Severity="Warning" Title="Solid-state drive"
                            Message="Wiping free space on an SSD adds wear and can't guarantee every old block is overwritten."
                            Visibility="{Binding EvidenceIsSsd, Converter={StaticResource BoolToVis}}" />
                <ProgressBar Height="6" Margin="0,16,0,0" Maximum="100" Value="{Binding EvidenceProgress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Command="{Binding WipeFreeSpaceCommand}" Content="Wipe free space" Icon="{ui:SymbolIcon ShieldLock24}" />
                    <ui:Button Margin="8,0,0,0" Command="{Binding CancelWorkCommand}" Content="Stop" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Shredder  -->
        <Border x:Name="ShredDrop" Grid.Row="2" AllowDrop="True" Drop="ShredDrop_Drop" Style="{StaticResource Card}" Visibility="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Shredder}">
            <DockPanel>
                <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Unrecoverable delete" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Overwrites files before deleting them so no tool can bring them back. Drag files or folders here." />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Command="{Binding AddShredFilesCommand}" Content="Add files" Icon="{ui:SymbolIcon DocumentAdd24}" />
                        <ui:Button Command="{Binding AddShredFolderCommand}" Content="Add folder" Icon="{ui:SymbolIcon FolderAdd24}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0" DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="Method" />
                        <ComboBox MinWidth="220" ItemsSource="{Binding WipeMethods}" SelectedItem="{Binding WipeMethod}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Command="{Binding CancelWorkCommand}" Content="Stop" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <ui:Button Appearance="Danger" Command="{Binding ShredCommand}" Content="Erase forever" Icon="{ui:SymbolIcon Fire24}" />
                    </StackPanel>
                </Grid>
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding ShredList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                        <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Command="{Binding DataContext.RemoveShredCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Dismiss16}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShredList.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}">
                            <ui:SymbolIcon HorizontalAlignment="Center" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="ArrowDownload24" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Secondary}" Text="Drop files and folders here" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!--  Status bar  -->
        <Grid Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:ProgressRing Width="18" Height="18" Margin="0,0,10,0" IsIndeterminate="True" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Status}" />
            <ui:Button Grid.Column="2" Command="{Binding CancelWorkCommand}" Content="Cancel" />
        </Grid>
    </Grid>
</Page>
