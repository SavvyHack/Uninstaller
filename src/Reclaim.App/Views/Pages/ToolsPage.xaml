<Page
    x:Class="Reclaim.App.Views.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Reclaim.App.ViewModels"
    Title="Tools"
    d:DataContext="{d:DesignInstance Type=vm:ToolsViewModel}"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Tools" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Move programs between drives, keep them updated, and reach Windows' own tools in one click." />

            <WrapPanel Margin="0,20,0,8">
                <RadioButton Content="Software relocator" GroupName="t" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Relocator}" Style="{StaticResource Chip}" />
                <RadioButton Content="Software updater" GroupName="t" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Updater}" Style="{StaticResource Chip}" />
                <RadioButton Content="Windows tools" GroupName="t" IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Windows}" Style="{StaticResource Chip}" />
            </WrapPanel>

            <!--  Relocator  -->
            <StackPanel Visibility="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Relocator}">
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Move a program to another drive" />
                        <TextBlock Margin="0,4,0,16" Style="{StaticResource Secondary}" FontSize="13" Text="Frees space on your system drive without reinstalling. A link stays at the old location, so everything keeps working." TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource Secondary}" Text="Program" />
                                <ComboBox DisplayMemberPath="Name" IsEditable="False" ItemsSource="{Binding MovableApps}" SelectedItem="{Binding RelocateApp}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource Secondary}" Text="Move to" />
                                <ComboBox ItemsSource="{Binding TargetDrives}" SelectedItem="{Binding TargetDrive}" />
                            </StackPanel>
                            <ui:Button Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Bottom" Appearance="Primary" Command="{Binding MoveCommand}" Content="Move" Icon="{ui:SymbolIcon ArrowRight24}"
                                       IsEnabled="{Binding Relocating, Converter={StaticResource InverseBool}}" />
                        </Grid>
                        <ui:InfoBar Margin="0,14,0,0" IsClosable="False" IsOpen="True" Severity="Informational" Title="Only one drive found"
                                    Message="Connect another internal or external drive to move programs off your system drive."
                                    Visibility="{Binding SingleDrive, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" Visibility="{Binding RelocateStatus, Converter={StaticResource HasValueToVis}}">
                            <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding Relocating, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding RelocateStatus}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Moved programs" Visibility="{Binding Relocations.Count, Converter={StaticResource HasValueToVis}}" />
                <ItemsControl ItemsSource="{Binding Relocations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Style="{StaticResource SubtleCard}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding AppName}" />
                                        <TextBlock Style="{StaticResource Secondary}"><Run Text="{Binding OriginalPath, Mode=OneWay}" /><Run Text="  →  " /><Run Text="{Binding NewPath, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                    <ui:Button HorizontalAlignment="Right" Command="{Binding DataContext.UndoMoveCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Content="Move back" Icon="{ui:SymbolIcon ArrowUndo24}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Updater  -->
            <StackPanel Visibility="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Updater}">
                <Border Style="{StaticResource Card}" Padding="24">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Software updater" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" FontSize="13" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:ProgressRing Width="20" Height="20" Margin="0,0,12,0" IsIndeterminate="True" Visibility="{Binding Checking, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Margin="0,0,8,0" Command="{Binding CheckUpdatesCommand}" Content="Check now" Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button Appearance="Primary" Command="{Binding UpdateAllCommand}" Content="Update all" Visibility="{Binding Updates.Count, Converter={StaticResource HasValueToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Updates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UpdateItemViewModel}">
                            <Border Margin="0,0,0,6" Style="{StaticResource SubtleCard}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Update.Name}" />
                                        <TextBlock Style="{StaticResource Secondary}"><Run Text="{Binding Update.InstalledVersion, Mode=OneWay}" /><Run Text="  →  " /><Run Text="{Binding Update.AvailableVersion, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding Update.Id, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding State}" />
                                        <ui:Button Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Content="Update"
                                                   IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Windows tools  -->
            <ItemsControl ItemsSource="{Binding WindowsTools}" Visibility="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Windows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Margin="0,0,-12,0" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardAction Margin="0,0,12,12" Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" IsChevronVisible="False">
                            <ui:CardAction.Icon>
                                <ui:SymbolIcon Symbol="{Binding Glyph}" />
                            </ui:CardAction.Icon>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Description}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
